{
  "name": "gerald-wants-up",
  "productName": "Gerald Wants Up",
  "version": "1.0.0",
  "description": "A weird idle game about a beanstalk with a grievance.",
  "author": "Gerald Wants Up",
  "main": "main.js",
  "private": true,
  "steamAppId": 480,
  "scripts": {
    "sync": "node tools/sync.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "node tools/sync.js && electron-builder --win dir",
    "dist:all": "node tools/sync.js && electron-builder --win dir --linux dir",
    "art": "node tools/art-server.js",
    "selftest": "electron . --selftest"
  },
  "build": {
    "appId": "com.geraldwantsup.game",
    "productName": "Gerald Wants Up",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**/*"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**/*"
    ],
    "extraFiles": [
      {
        "from": "node_modules/steamworks.js/dist/win64",
        "to": ".",
        "filter": [
          "*.dll"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.png",
      "files": [
        "!node_modules/steamworks.js/dist/osx/**",
        "!node_modules/steamworks.js/dist/linux64/**",
        "!node_modules/steamworks.js/dist/win64/*.lib"
      ]
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "Game",
      "extraFiles": [
        {
          "from": "node_modules/steamworks.js/dist/linux64",
          "to": ".",
          "filter": [
            "*.so"
          ]
        }
      ],
      "files": [
        "!node_modules/steamworks.js/dist/osx/**",
        "!node_modules/steamworks.js/dist/win64/**"
      ]
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "@fontsource/chewy": "5.3.0",
    "@fontsource/gaegu": "5.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
